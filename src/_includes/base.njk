<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or summary }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.name }}">
  <meta property="og:description" content="{{ description or summary }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="preload" href="/assets/fonts/doyle-serif-roman.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/css/site.css">
  {%- for section in sections %}{% if section.id == "notes" and section.show %}
  <link rel="alternate" type="application/atom+xml" href="/notes/feed.xml" title="{{ site.name }} · {{ section.label }}">
  {%- endif %}{% endfor %}
</head>
<body>
  {% include "masthead.njk" %}

  <main{% if pageClass %} class="{{ pageClass }}"{% endif %}>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p class="site-footer__mark">{{ site.name }} · Vol. V · No. {{ edition.number }}</p>
    <p class="attestation"><a href="/verify/">build {{ build.sha or "…" }} · signed {{ site.keyFingerprint or "…" }} · verify →</a></p>
  </footer>
  {%- if page.url == "/" %}
  {% include "dateline-tick.njk" %}
  {%- endif %}
</body>
</html>
