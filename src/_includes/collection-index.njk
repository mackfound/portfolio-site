{# Index page for one collection (`indexCollection` in scope): its front-page
   section first, then past work. Group ids match section ids, so a front-page
   "All …" link can land on its group. #}
{% set inIndex = true %}
{% set groups = [] %}
{% for section in sections %}{% if section.collection == indexCollection %}
  {% set groups = (groups.push({ id: section.id, label: "Current", collection: indexCollection, filter: section.filter }), groups) %}
{% endif %}{% endfor %}
{% set groups = (groups.push({ id: "past", label: "Past", collection: indexCollection, filter: { status: "past" } }), groups) %}

<h1>{{ title }}</h1>

{% for group in groups %}
{% set entries = collections | sectionEntries(group) %}
{% if entries.length %}
<section id="{{ group.id }}" class="section" aria-labelledby="{{ group.id }}-heading">
  <h2 class="section__head" id="{{ group.id }}-heading">{{ group.label }}</h2>
  <ul class="entries">
  {% for entry in entries %}
    {% include "entry.njk" %}
  {% endfor %}
  </ul>
</section>
{% endif %}
{% endfor %}
