{# Generic front-page renderer for one entry of sections.json (`section` in scope).
   A `collection` section lists its latest entries; a `page` section shows that
   page's `blurb` and links to it. #}
<section id="{{ section.id }}" class="section{% if section.page %} section--page{% endif %}" aria-labelledby="{{ section.id }}-heading">
  <h2 class="section__head" id="{{ section.id }}-heading">{{ section.label }}</h2>
{% if section.page %}
  {% set target = collections.all | pageByUrl(section.page) %}
  <p>{{ target.data.blurb }}</p>
  {% if target.data.contact %}{% include "contact.njk" %}{% endif %}
  <p class="section__more"><a href="{{ section.page }}">More →</a></p>
{% else %}
  {# The site's one `lead: true` entry, when it's in this section, leads it. #}
  {% set entries = collections | sectionEntries(section) %}
  {% for entry in entries %}{% if entry.data.lead %}
  <ul class="entries lead">
    {% include "entry.njk" %}
  </ul>
  {% endif %}{% endfor %}
  {% set rest = [] %}
  {% for entry in entries %}{% if not entry.data.lead %}{% set rest = (rest.push(entry), rest) %}{% endif %}{% endfor %}
  {% if rest.length %}
  <ul class="entries">
  {% for entry in rest %}
    {% include "entry.njk" %}
  {% endfor %}
  </ul>
  {% endif %}
  {% set indexUrl = section | sectionIndexUrl(collections.all) %}
  {% if indexUrl %}<p class="section__more"><a href="{{ indexUrl }}">All {{ section.label | lower }} →</a></p>{% endif %}
{% endif %}
</section>
