{# Generic front-page renderer for one entry of sections.json (`section` in scope).
   A `collection` section lists its latest entries; a `page` section shows that
   page's `blurb` and links to it. #}
<section id="{{ section.id }}" class="section{% if section.page %} section--page{% endif %}" aria-labelledby="{{ section.id }}-heading">
  <h2 class="section__head" id="{{ section.id }}-heading">{{ section.label }}</h2>
{% if section.page %}
  {% set target = collections.all | pageByUrl(section.page) %}
  <p>{{ target.data.blurb }}</p>
  {% if target.data.contact %}{% include "contact.njk" %}{% endif %}
  <p class="section__more"><a href="{{ section.page }}">More →</a></p>
{% else %}
  <ul class="entries">
  {% for entry in collections | sectionEntries(section) %}
    <li class="entry">
      <h3 class="entry__title"><a href="{{ entry.data.url or entry.url }}">{{ entry.data.title }}</a></h3>
      <p class="entry__meta">
        {% if entry.data.outlet %}{{ entry.data.outlet }} · {% endif %}
        {% if entry.data.date %}<time datetime="{{ entry.data.date | isoDate }}">{{ entry.data.date | displayDate }}</time>{% elif entry.data.period %}{{ entry.data.period }}{% endif %}
      </p>
      <p class="entry__summary">{{ entry.data.summary or entry.data.deck }}</p>
    </li>
  {% endfor %}
  </ul>
  {% set index = collections.all | pageByUrl("/" + section.collection + "/") %}
  {% if index %}<p class="section__more"><a href="{{ index.url }}">All {{ section.label | lower }} →</a></p>{% endif %}
{% endif %}
</section>
