---
layout: base.njk
---
<article>
  <h1>{{ title }}</h1>
  <dl>
    <dt>Role</dt><dd>{{ role }}</dd>
    <dt>Period</dt><dd>{{ period }}</dd>
    <dt>Stack</dt><dd>{{ stack | join(", ") }}</dd>
  </dl>
  {% if links.live %}<p><a href="{{ links.live }}">Live →</a></p>{% endif %}
  {% if links.source %}<p><a href="{{ links.source }}">Source →</a></p>{% endif %}
  {{ content | safe }}
</article>
